---
import Base from '../layouts/Base.astro';
import { profile, publicationPrograms } from '../data/site';
---

<Base
  title="Publications | James Young"
  description="Publications by James Young across functional discovery and nitrogen fixation, protein learning, comparative genomics, and computational biology."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / publications</span>
      <h1>Publications</h1>
      <div class="page-intro">
        <span class="section-kicker">Research programs</span>
        <p>Three connected programs: discovering function in undercharacterized systems, learning across protein sequence space, and integrating broader biological evidence.</p>
      </div>
      <div class="text-links">
        <a class="text-link" href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      {publicationPrograms.map((program) => (
        <section class="program-section" id={program.id}>
          <div class="program-heading">
            <h2>{program.title}</h2>
            <p>{program.description}</p>
          </div>
          <div class="publication-list">
            {program.publications.map((publication) => (
              <article class="publication-item">
                <span class="citation">{publication.citation}</span>
                <div>
                  <h3>{publication.title}</h3>
                </div>
                {publication.href ? (
                  <a class="publication-link" href={publication.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${publication.title}`}>
                    {publication.accessLabel ?? 'Publication record'} <span aria-hidden="true">↗</span>
                  </a>
                ) : null}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>
