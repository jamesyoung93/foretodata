---
import Base from '../layouts/Base.astro';
import { profile, publicationPrograms } from '../data/site';

const programContexts: Record<string, string> = {
  'functional-discovery': 'Evidence for finding biological mechanisms when function is uncertain, signals are spread across data sources, and experiments are limited.',
  'protein-learning': 'Evidence for using learned protein representations to compare a large search space and choose more informative variants to test.',
  'comparative-biology': 'Evidence for combining biological measurements across organisms, molecular layers, and collaborators to answer questions no single dataset can resolve.',
};
---

<Base
  title="Publications | James Young"
  description="Peer-reviewed evidence behind James Young's work in scientific machine learning for choosing better experiments in complex biological systems."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / publications</span>
      <h1>Research evidence for better experiments.</h1>
      <div class="page-intro">
        <span class="section-kicker">Represent → Simulate → Decide → Learn</span>
        <p>These publications test the scientific foundations of the larger decision framework: represent incomplete evidence, model and compare possibilities, decide what to test, and use results to improve the next experiment.</p>
      </div>
      <div class="text-links">
        <a class="text-link" href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      {publicationPrograms.map((program) => (
        <section class="program-section" id={program.id}>
          <div class="program-heading">
            <h2>{program.title}</h2>
            <p>{programContexts[program.id] ?? program.description}</p>
          </div>
          <div class="publication-list">
            {program.publications.map((publication) => (
              <article class="publication-item">
                <span class="citation">{publication.citation}</span>
                <div>
                  <h3>{publication.title}</h3>
                </div>
                {publication.href ? (
                  <a class="publication-link" href={publication.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${publication.title}`}>
                    {publication.accessLabel ?? 'Publication record'} <span aria-hidden="true">↗</span>
                  </a>
                ) : null}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>
