---
import Base from '../../layouts/Base.astro';
import { caseStudies, type CaseStudy } from '../../data/site';
import { sitePath } from '../../utils/paths';

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<Base title={`${study.title} | James Young`} description={study.summary}>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / work / {study.slug}</span>
      <h1>{study.title}</h1>
      <div class="page-intro">
        <span class="section-kicker">{study.domain}</span>
        <p class="lede">{study.summary}</p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="shell case-detail-grid">
      <aside class="case-index" aria-label={`${study.recordType} sections`}>
        <span class="meta-label">Overview</span>
        <a href="#decision">Decision to improve</a>
        <a href="#context">What shapes the outcome</a>
        <a href="#difficulty">Constraints and uncertainty</a>
        <a href="#approach">How the system works</a>
        <a href="#outcome">What it enables</a>
        <a href="#role">What I built</a>
        {study.evidence && <a href="#evidence">Supporting evidence</a>}
      </aside>
      <article class="case-detail">
        <span class="section-kicker">{study.recordType}</span>
        <h2 id="decision">Decision to improve</h2>
        <p class="lead-paragraph">{study.question}</p>

        <h2 id="context">What shapes the outcome</h2>
        <p>{study.context}</p>

        <h2 id="difficulty">Constraints and uncertainty</h2>
        <ul class="clean-list">
          {study.difficulty.map((item) => <li>{item}</li>)}
        </ul>

        <h2 id="approach">How the system works</h2>
        <ol class="clean-list">
          {study.approach.map((item) => <li>{item}</li>)}
        </ol>

        <h2 id="outcome">What this system enables</h2>
        <p>{study.outcome}</p>

        <h2 id="role">What I built</h2>
        <p>{study.role}</p>

        {study.evidence && (
          <div class="evidence-box" id="evidence">
            <span class="meta-label">Supporting evidence</span>
            <p><a href={study.evidence.href} target="_blank" rel="noopener noreferrer">{study.evidence.label} <span aria-hidden="true">↗</span></a></p>
          </div>
        )}


        <div class="text-links">
          <a class="text-link" href={sitePath('work')}><span aria-hidden="true">←</span> All selected work</a>
        </div>
      </article>
    </div>
  </section>
</Base>

