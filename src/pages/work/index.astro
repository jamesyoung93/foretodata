---
import Base from '../../layouts/Base.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { caseStudies } from '../../data/site';
import { sitePath } from '../../utils/paths';
---

<Base
  title="Selected Work | James Young"
  description="Selected scientific machine-learning, biological discovery, advisory, and operational decision-system work by James Young."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / work</span>
      <h1>Selected work</h1>
      <div class="page-intro">
        <span class="section-kicker">Question → evidence → decision</span>
        <p>Curated case studies emphasizing the question, constraints, analytical approach, resulting capability, and James’s role. Methods support the story; they are not the story.</p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="case-grid">
        {caseStudies.slice(0, 3).map((study, index) => <CaseStudyCard study={study} index={index} />)}
      </div>
      {caseStudies.slice(3).map((study) => (
        <a class="secondary-work" href={sitePath(`work/${study.slug}`)}>
          <div>
            <strong>{study.title}</strong>
            <p>{study.summary}</p>
          </div>
          <span aria-hidden="true">→</span>
        </a>
      ))}
      <p class="disclosure">Representative work is summarized at a high level. Some details and results have been generalized to protect confidential information.</p>
    </div>
  </section>
</Base>
