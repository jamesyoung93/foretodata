---
import Base from '../../layouts/Base.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { caseStudies } from '../../data/site';
---

<Base
  title="Selected Work | James Young"
  description="Selected decision systems, interactive AI products, adaptive analytical platforms, and scientific machine-learning work by James Young."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / work</span>
      <h1>Complex systems, turned into decision products.</h1>
      <div class="page-intro">
        <span class="section-kicker">Represent → simulate → decide → learn</span>
        <p>The domains range from resource allocation and governed analytics to local LLMs and biological discovery. Each record starts with the decision the system is meant to improve.</p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="case-grid">
        {caseStudies.map((study, index) => <CaseStudyCard study={study} index={index} />)}
      </div>
    </div>
  </section>
</Base>
