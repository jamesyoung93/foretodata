---
import Base from '../../layouts/Base.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { caseStudies } from '../../data/site';
---

<Base
  title="Selected Work | James Young"
  description="Decision systems by James Young that make complex choices across operations, interactive AI, and scientific machine learning clearer and more actionable."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / work</span>
      <h1>Decision systems for complex domains, in practice.</h1>
      <div class="page-intro">
        <span class="section-kicker">Represent → Simulate → Decide → Learn</span>
        <p>The applications span decision systems, interactive AI, and scientific machine learning. Each uses the same approach: represent what shapes the outcome, simulate possible actions, decide on the best feasible option, and learn from the result.</p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="case-grid">
        {caseStudies.map((study, index) => <CaseStudyCard study={study} index={index} />)}
      </div>
    </div>
  </section>
</Base>
