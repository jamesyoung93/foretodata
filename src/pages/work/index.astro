---
import Base from '../../layouts/Base.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { caseStudies } from '../../data/site';
---

<Base
  title="Selected Work | James Young"
  description="Decision and optimization systems by James Young that make complex choices clearer, testable, and actionable."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / work</span>
      <h1>Systems that make complex choices clearer, testable, and actionable.</h1>
      <div class="page-intro">
        <span class="section-kicker">Map → Simulate → Optimize → Learn</span>
        <p>The applications range from resource allocation and private AI to biological discovery. Each uses the same approach: map what shapes the outcome, compare possible actions, choose the best feasible option, and learn from the result.</p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="case-grid">
        {caseStudies.map((study, index) => <CaseStudyCard study={study} index={index} />)}
      </div>
    </div>
  </section>
</Base>
