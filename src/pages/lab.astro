---
import Base from '../layouts/Base.astro';
import LabExplorer from '../components/LabExplorer.jsx';
import { profile } from '../data/site';
import { sitePath } from '../utils/paths';
---

<Base
  title="Lab Mode | James Young"
  description="Explore how James Young represents, simulates, decides, and learns when building decision systems for complex domains."
  mode="lab"
>
  <section class="lab-shell">
    <div class="shell lab-terminal">
      <div class="terminal-bar">
        <span>foretodata://lab</span>
        <span>Represent → Simulate → Decide → Learn</span>
      </div>
      <div class="terminal-content">
        <span class="lab-prompt">$ whoami</span>
        <h1>{profile.name}</h1>
        <p class="lab-intro">I build decision systems for complex domains. Across decision systems, interactive AI, and scientific machine learning, the same loop turns many interacting variables into a feasible next action. Language models can make that system conversational while reliable calculations, evidence, privacy, and approval boundaries remain explicit.</p>

        <nav class="lab-command-nav" aria-label="Lab navigation">
          <a href={sitePath('work')}>./work</a>
          <a href={sitePath('research')}>./research</a>
          <a href={sitePath('publications')}>./publications</a>
          <a href={sitePath('writing')}>./insights</a>
          <a href={sitePath('surprise')}>./surprise-me</a>
        </nav>

        <LabExplorer client:load basePath={import.meta.env.BASE_URL} />
      </div>
    </div>
  </section>
</Base>

