---
import Base from '../layouts/Base.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import DiscoveryDiagram from '../components/DiscoveryDiagram.astro';
import { approachPrinciples, caseStudies, profile, publicationPrograms } from '../data/site';
import { sitePath } from '../utils/paths';

const featured = caseStudies.filter((study) => study.featured);
const featuredPublications = publicationPrograms
  .flatMap((program) => program.publications)
  .filter((publication) => publication.featureRank)
  .sort((a, b) => (a.featureRank ?? 99) - (b.featureRank ?? 99));
---

<Base>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <span class="eyebrow">James Young / scientific machine learning</span>
        <h1>{profile.headline}</h1>
        <p class="lede">{profile.summary}</p>
        <div class="text-links">
          <a class="text-link" href={sitePath('work')}>Selected work <span aria-hidden="true">→</span></a>
          <a class="text-link" href={sitePath('research')}>Research program <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="hero-note" aria-label="Practice focus">
        <span class="meta-label">Unifying idea</span>
        <p><strong>Turning complex data into prioritized action.</strong></p>
        <p>Biological discovery is the primary domain. Decision systems show how models can support recurring operational choices.</p>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="credibility-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">01 / Perspective</span>
        <div>
          <h2 id="credibility-heading">Scientific depth, analytical judgment, applied leadership.</h2>
        </div>
      </div>
      <div class="credibility-grid">
        <div class="credibility-item">
          <span class="meta-label">Biology</span>
          <strong>PhD in Biological Sciences</strong>
          <p>Specializing in molecular biology, with work spanning functional discovery, comparative genomics, multi-omics, and protein learning.</p>
        </div>
        <div class="credibility-item">
          <span class="meta-label">Research</span>
          <strong>Peer-reviewed computational biology</strong>
          <p>Published work on oxic nitrogen fixation and broader biological data integration.</p>
        </div>
        <div class="credibility-item">
          <span class="meta-label">Application</span>
          <strong>Applied machine-learning leadership</strong>
          <p>Forecasting, causal inference, targeting, resource allocation, and implementation.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="selected-work" aria-labelledby="work-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">02 / Selected work</span>
        <div>
          <h2 id="work-heading">Questions where search, evidence, and decisions meet.</h2>
          <p>The work connects research questions and operating constraints to analytical choices and concrete outcomes.</p>
        </div>
      </div>
      <div class="case-grid">
        {featured.map((study, index) => <CaseStudyCard study={study} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="open-research-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">03 / Open research</span>
        <div>
          <h2 id="open-research-heading">Recent machine-learning publications.</h2>
          <p>Recent papers span gene-function discovery, protein representation, and metabolite-based classification.</p>
        </div>
      </div>
      <div class="writing-list">
        {featuredPublications.map((publication) => (
          <a class="writing-row" href={publication.href} target="_blank" rel="noopener noreferrer">
            <span class="archive-meta">{publication.citation}</span>
            <div>
              <h3>{publication.title}</h3>
              <p>{publication.accessLabel}</p>
            </div>
            <span class="archive-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="text-links">
        <a class="text-link" href={sitePath('publications')}>All publications <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="research-heading">
    <div class="shell research-grid">
      <div>
        <span class="section-kicker">04 / Current research</span>
        <h2 id="research-heading">ML-guided functional discovery in undercharacterized microbial systems.</h2>
        <p class="lede">Oxygen-tolerant nitrogen fixation in cyanobacteria is the flagship application within a broader research program.</p>
        <p>The broader method connects comparative genomics, condition-specific multi-omics, protein representations, candidate prioritization, active learning, and experimental validation planning.</p>
        <div class="text-links">
          <a class="text-link" href={sitePath('research')}>Explore the research program <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <DiscoveryDiagram />
    </div>
  </section>

  <section class="section" aria-labelledby="approach-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">05 / Approach</span>
        <div><h2 id="approach-heading">The model is one part of the reasoning system.</h2></div>
      </div>
      <div class="approach-grid">
        {approachPrinciples.map((principle) => (
          <article class="principle">
            <span class="meta-label">{principle.index}</span>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
