---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import DiscoveryDiagram from '../components/DiscoveryDiagram.astro';
import { approachPrinciples, caseStudies, profile } from '../data/site';
import { sitePath } from '../utils/paths';

const featured = caseStudies.filter((study) => study.featured);
const secondary = caseStudies.find((study) => !study.featured);
const selectedSlugs = [
  'predicting-dna-properties-bioinformatics',
  'causal-inference-practical-guide',
  'interpretable-ml-business',
];
const posts = (await getCollection('blog'))
  .filter((post) => selectedSlugs.includes(post.slug))
  .sort((a, b) => selectedSlugs.indexOf(a.slug) - selectedSlugs.indexOf(b.slug));

const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<Base>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <span class="eyebrow">James Young / scientific machine learning</span>
        <h1>{profile.headline}</h1>
        <p class="lede">{profile.summary}</p>
        <div class="text-links">
          <a class="text-link" href={sitePath('work')}>Selected work <span aria-hidden="true">→</span></a>
          <a class="text-link" href={sitePath('research')}>Research program <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="hero-note" aria-label="Practice focus">
        <span class="meta-label">Unifying idea</span>
        <p><strong>Turning complex data into prioritized action.</strong></p>
        <p>Biological discovery is the primary domain. Decision systems provide evidence of translating models into consequential use.</p>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="credibility-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">01 / Perspective</span>
        <div>
          <h2 id="credibility-heading">Scientific depth, analytical judgment, operational consequence.</h2>
        </div>
      </div>
      <div class="credibility-grid">
        <div class="credibility-item">
          <span class="meta-label">Biology</span>
          <strong>PhD-trained molecular biologist</strong>
          <p>Functional discovery, comparative genomics, multi-omics, and protein learning.</p>
        </div>
        <div class="credibility-item">
          <span class="meta-label">Research</span>
          <strong>Peer-reviewed computational biology</strong>
          <p>Published work on oxic nitrogen fixation and broader biological data integration.</p>
        </div>
        <div class="credibility-item">
          <span class="meta-label">Application</span>
          <strong>Applied machine-learning leadership</strong>
          <p>Forecasting, causal inference, targeting, resource allocation, and implementation.</p>
        </div>
        <div class="credibility-item">
          <span class="meta-label">Independent work</span>
          <strong>Selective biotechnology advisory</strong>
          <p>Narrowly scoped scientific and technical questions, typically through relevant introductions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="selected-work" aria-labelledby="work-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">02 / Selected work</span>
        <div>
          <h2 id="work-heading">Questions where search, evidence, and decisions meet.</h2>
          <p>Each case is framed around the underlying question, the constraints that made it difficult, and the role of computation in changing what could be considered next.</p>
        </div>
      </div>
      <div class="case-grid">
        {featured.map((study, index) => <CaseStudyCard study={study} index={index} />)}
      </div>
      {secondary && (
        <a class="secondary-work" href={sitePath(`work/${secondary.slug}`)}>
          <div>
            <strong>{secondary.title}</strong>
            <p>{secondary.summary}</p>
          </div>
          <span aria-hidden="true">→</span>
        </a>
      )}
      <p class="disclosure">Representative work is summarized at a high level. Some details and results have been generalized to protect confidential information.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="research-heading">
    <div class="shell research-grid">
      <div>
        <span class="section-kicker">03 / Current research</span>
        <h2 id="research-heading">ML-guided functional discovery in undercharacterized microbial systems.</h2>
        <p class="lede">Oxygen-tolerant nitrogen fixation in cyanobacteria is a flagship biological application—not the boundary of the program.</p>
        <p>The broader method connects comparative genomics, condition-specific multi-omics, protein representations, candidate prioritization, active learning, and experimental validation planning.</p>
        <div class="text-links">
          <a class="text-link" href={sitePath('research')}>Explore the research program <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <DiscoveryDiagram />
    </div>
  </section>

  <section class="section" aria-labelledby="approach-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">04 / Approach</span>
        <div><h2 id="approach-heading">The model is one part of the reasoning system.</h2></div>
      </div>
      <div class="approach-grid">
        {approachPrinciples.map((principle) => (
          <article class="principle">
            <span class="meta-label">{principle.index}</span>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="independent-work" aria-labelledby="independent-heading">
    <div class="shell quiet-panel">
      <span class="section-kicker">05 / Independent work</span>
      <h2 id="independent-heading">Occasional advisory work on narrowly scoped scientific-AI questions.</h2>
      <p>Outside my primary role, I occasionally advise biotechnology and research teams on problems in computational biology and scientific machine learning.</p>
      <ul class="question-list">
        <li>Can the available data support a useful predictive or prioritization system?</li>
        <li>Which proteins, genes, pathways, variants, strains, or conditions should be tested first?</li>
        <li>How should computational predictions become a practical validation plan?</li>
        <li>How should an organization evaluate an internal or vendor-proposed AI approach before a larger investment?</li>
      </ul>
      <p>I keep outside engagements limited and avoid work that creates professional or intellectual-property conflicts. Relevant introductions are welcome.</p>
      <div class="text-links">
        <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">06 / Selected writing</span>
        <div>
          <h2 id="writing-heading">Notes on models, evidence, and what happens next.</h2>
        </div>
      </div>
      <div class="writing-list">
        {posts.map((post) => (
          <a class="writing-row" href={sitePath(`posts/${post.slug}`)}>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="text-links">
        <a class="text-link" href={sitePath('writing')}>Complete writing archive <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>
