---
import Base from '../layouts/Base.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import DiscoveryDiagram from '../components/DiscoveryDiagram.astro';
import HeroSystemDiagram from '../components/HeroSystemDiagram.astro';
import SystemsLens from '../components/SystemsLens.jsx';
import { capabilityLanes, caseStudies, profile, publicationPrograms } from '../data/site';
import { sitePath } from '../utils/paths';

const featured = caseStudies.filter((study) => study.featured);
const featuredPublications = publicationPrograms
  .flatMap((program) => program.publications)
  .filter((publication) => publication.featureRank)
  .sort((a, b) => (a.featureRank ?? 99) - (b.featureRank ?? 99));
---

<Base
  title="James Young | Decision Systems for Complex Domains"
  description="James Young builds decision systems for complex domains across resource allocation, interactive AI, and scientific machine learning."
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="hero-nameplate"><span>James Young</span></div>
        <h1>{profile.headline}</h1>
        <p class="lede">{profile.summary}</p>
        <p class="hero-capability-line">Decision systems &middot; Interactive AI &middot; Scientific machine learning</p>
        <p class="hero-process">Represent &rarr; Simulate &rarr; Decide &rarr; Learn</p>
        <div class="text-links">
          <a class="text-link" href="#selected-work">See systems in practice <span aria-hidden="true">&darr;</span></a>
          <a class="text-link" href={sitePath('lab')}>Explore Lab Mode <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <HeroSystemDiagram />
    </div>
  </section>

  <section class="section systems-section" id="systems-lens" aria-labelledby="systems-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">01 / How it works</span>
        <div>
          <h2 id="systems-heading">Represent the system &rarr; Simulate possibilities &rarr; Decide what to do &rarr; Learn from the result.</h2>
          <p>Represent the outcome, controllable variables, outside conditions, and real constraints. Then simulate plausible scenarios, decide among feasible actions, and use each result to improve the next choice.</p>
        </div>
      </div>
      <SystemsLens client:load />
    </div>
  </section>

  <section class="section" aria-labelledby="capabilities-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">02 / Where it applies</span>
        <div>
          <h2 id="capabilities-heading">Decision systems. Interactive AI. Scientific machine learning.</h2>
          <p>Three expressions of the same approach: represent a complex domain clearly, make its possibilities explorable, and turn uncertainty into a better next decision.</p>
        </div>
      </div>
      <div class="capability-grid">
        {capabilityLanes.map((lane) => (
          <article class="capability-card">
            <div>
              <span class="meta-label">{lane.index} / {lane.title}</span>
              <h3>{lane.promise}</h3>
              <p>{lane.text}</p>
            </div>
            <span class="capability-extension">{lane.extension}</span>
          </article>
        ))}
      </div>
      <p class="lens-caption">I work with startups, enterprises, and research institutes, beginning with one important problem and extending what proves useful.</p>
    </div>
  </section>

  <section class="section" id="selected-work" aria-labelledby="work-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">03 / Systems built</span>
        <div>
          <h2 id="work-heading">Systems built around real choices.</h2>
          <p>Examples include optimizing resource allocation, working privately with long documents, answering business questions with evidence, adapting analytics to new data, and deciding which experiment to run next.</p>
        </div>
      </div>
      <div class="case-grid">
        {featured.map((study, index) => <CaseStudyCard study={study} index={index} />)}
      </div>
      <div class="text-links">
        <a class="text-link" href={sitePath('work')}>See all work <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="research-heading">
    <div class="shell">
      <div class="research-grid">
        <div>
          <span class="section-kicker">04 / Evidence</span>
          <h2 id="research-heading">Published research shows the method in a difficult setting.</h2>
          <p class="lede">When every experiment is slow and expensive, choosing what to test next matters.</p>
          <p>I combine biological evidence and machine learning to narrow large search spaces, compare promising candidates, show what remains uncertain, and plan the next useful experiment.</p>
          <div class="text-links">
            <a class="text-link" href={sitePath('research')}>Explore the research program <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
        <DiscoveryDiagram />
      </div>
      <div class="writing-list">
        {featuredPublications.map((publication) => (
          <a class="writing-row" href={publication.href} target="_blank" rel="noopener noreferrer">
            <span class="archive-meta">{publication.citation}</span>
            <div>
              <h3>{publication.title}</h3>
              <p>{publication.accessLabel}</p>
            </div>
            <span class="archive-arrow" aria-hidden="true">&nearr;</span>
          </a>
        ))}
      </div>
      <div class="text-links">
        <a class="text-link" href={sitePath('publications')}>See all publications <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>
</Base>
