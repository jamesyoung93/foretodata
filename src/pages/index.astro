---
import Base from '../layouts/Base.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import DiscoveryDiagram from '../components/DiscoveryDiagram.astro';
import SystemsLens from '../components/SystemsLens.jsx';
import { approachPrinciples, capabilityLanes, caseStudies, organizationNeeds, profile, publicationPrograms } from '../data/site';
import { sitePath } from '../utils/paths';

const featured = caseStudies.filter((study) => study.featured);
const featuredPublications = publicationPrograms
  .flatMap((program) => program.publications)
  .filter((publication) => publication.featureRank)
  .sort((a, b) => (a.featureRank ?? 99) - (b.featureRank ?? 99));
---

<Base
  title="James Young | Decision Systems, Interactive AI & Scientific ML"
  description="James Young builds extensible intelligence for complex decisions: adaptive decision systems, private and governed AI, interactive tools, and scientific machine learning."
>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <span class="eyebrow">Extensible decision infrastructure for startups, enterprises, and research institutes</span>
        <h1>{profile.headline}</h1>
        <p class="lede">{profile.summary}</p>
        <p class="hero-principle">Private where required. Interactive where useful. Governed wherever the stakes demand it.</p>
        <div class="text-links">
          <a class="text-link" href="#selected-work">See systems in practice <span aria-hidden="true">↓</span></a>
          <a class="text-link" href={sitePath('lab')}>Explore Lab Mode <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="hero-note" aria-label="Practice focus">
        <span class="meta-label">The opportunity</span>
        <p><strong>Move from isolated AI features to compounding decision capability.</strong></p>
        <p>Models become infrastructure when they connect to domain logic, real tools, human authority, and measurable feedback.</p>
      </aside>
    </div>
  </section>

  <section class="section horizon-section" aria-labelledby="horizon-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">01 / The horizon</span>
        <div>
          <h2 id="horizon-heading">From a valuable first use case to a capability that compounds.</h2>
          <p>Access to powerful models is no longer the differentiator. The harder and more valuable work is turning intelligence into an extensible operating system for decisions, workflows, and organizational learning.</p>
        </div>
      </div>
      <div class="audience-grid">
        {organizationNeeds.map((need) => (
          <article class="audience-card">
            <span class="meta-label">{need.audience}</span>
            <h3>{need.title}</h3>
            <p>{need.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section systems-section" id="systems-lens" aria-labelledby="systems-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">02 / Extensible architecture</span>
        <div>
          <h2 id="systems-heading">Different domains. The same underlying move.</h2>
          <p>Make the system legible, distinguish what can be changed from what must be observed, compare plausible interventions, and turn the result into a decision.</p>
        </div>
      </div>
      <SystemsLens client:load />
    </div>
  </section>

  <section class="section" aria-labelledby="capabilities-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">03 / What I build</span>
        <div>
          <h2 id="capabilities-heading">A modular practice that can expand with the problem.</h2>
          <p>Each lane can begin as a focused intervention and grow into shared infrastructure across teams, decisions, and domains.</p>
        </div>
      </div>
      <div class="capability-grid">
        {capabilityLanes.map((lane) => (
          <article class="capability-card">
            <div>
              <span class="meta-label">{lane.index} / {lane.title}</span>
              <h3>{lane.promise}</h3>
              <p>{lane.text}</p>
            </div>
            <span class="capability-extension">{lane.extension}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="selected-work" aria-labelledby="work-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">04 / Systems in practice</span>
        <div>
          <h2 id="work-heading">Systems built around real decisions.</h2>
          <p>Resource allocation, private document intelligence, governed analytics, adaptive pipelines, and experiment selection—each designed around an action, not only a prediction.</p>
        </div>
      </div>
      <div class="case-grid">
        {featured.map((study, index) => <CaseStudyCard study={study} index={index} />)}
      </div>
      <div class="text-links">
        <a class="text-link" href={sitePath('work')}>All work records <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="open-research-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">05 / Open research</span>
        <div>
          <h2 id="open-research-heading">Machine learning where every experiment is expensive.</h2>
          <p>Recent work integrates partial evidence, narrows large biological search spaces, exposes uncertainty, and identifies what is worth testing next.</p>
        </div>
      </div>
      <div class="writing-list">
        {featuredPublications.map((publication) => (
          <a class="writing-row" href={publication.href} target="_blank" rel="noopener noreferrer">
            <span class="archive-meta">{publication.citation}</span>
            <div>
              <h3>{publication.title}</h3>
              <p>{publication.accessLabel}</p>
            </div>
            <span class="archive-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="text-links">
        <a class="text-link" href={sitePath('publications')}>All publications <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="research-heading">
    <div class="shell research-grid">
      <div>
        <span class="section-kicker">06 / Scientific discovery</span>
        <h2 id="research-heading">A high-stakes search problem with expensive feedback.</h2>
        <p class="lede">Oxygen-tolerant nitrogen fixation is one flagship application of a broader system for machine-learning-guided functional discovery.</p>
        <p>Comparative genomics, condition-specific multi-omics, protein representations, active learning, and experimental planning work together to decide which candidate or variant should be tested next.</p>
        <div class="text-links">
          <a class="text-link" href={sitePath('research')}>Explore the research program <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <DiscoveryDiagram />
    </div>
  </section>

  <section class="section" aria-labelledby="approach-heading">
    <div class="shell">
      <div class="section-heading">
        <span class="section-kicker">07 / Operating pattern</span>
        <div>
          <h2 id="approach-heading">Build the next decision into the system from the start.</h2>
          <p>The recurring pattern is more durable than any one model, platform, or domain.</p>
        </div>
      </div>
      <div class="approach-grid">
        {approachPrinciples.map((principle) => (
          <article class="principle">
            <span class="meta-label">{principle.index}</span>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
