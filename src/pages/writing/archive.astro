---
import { getCollection } from 'astro:content';
import WritingArchive from '../../components/WritingArchive.astro';
import Base from '../../layouts/Base.astro';
import { sitePath } from '../../utils/paths';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.hidden)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Earlier Technical Notes | James Young"
  description="Selected earlier technical notes by James Young on forecasting, sequence alignment, and observational classification."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / insights / earlier notes</span>
      <h1>Earlier technical notes</h1>
      <div class="page-intro">
        <span class="section-kicker">2022–2025</span>
        <p>Selected analyses in forecasting, sequence alignment, and observational classification.</p>
      </div>
      <div class="text-links">
        <a class="text-link" href={sitePath('writing')}><span aria-hidden="true">←</span> Current insights</a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <WritingArchive
        posts={posts}
        heading="Selected notes"
        description="Methods, technical decisions, and analytical reasoning across three applied analyses."
      />
    </div>
  </section>
</Base>
