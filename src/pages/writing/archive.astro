---
import { getCollection } from 'astro:content';
import WritingArchive from '../../components/WritingArchive.astro';
import Base from '../../layouts/Base.astro';
import { sitePath } from '../../utils/paths';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.hidden)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Earlier Applied Analyses | James Young"
  description="Earlier analyses by James Young showing how evidence, modeling choices, and constraints shape real-world decisions."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / insights / earlier notes</span>
      <h1>Earlier notes on modeling real-world decisions.</h1>
      <div class="page-intro">
        <span class="section-kicker">Represent → Simulate → Decide → Learn</span>
        <p>Applied examples from 2022–2025 of representing a problem, testing an analytical approach, and deciding what the results can—and cannot—support.</p>
      </div>
      <div class="text-links">
        <a class="text-link" href={sitePath('writing')}><span aria-hidden="true">←</span> Current insights</a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <WritingArchive
        posts={posts}
        heading="Applied analyses"
        description="Forecasting, sequence comparison, and observational classification presented through the decisions each analysis was meant to inform."
      />
    </div>
  </section>
</Base>
