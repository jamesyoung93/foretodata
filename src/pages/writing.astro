---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WritingArchive from '../components/WritingArchive.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Writing | James Young"
  description="Writing by James Young on scientific machine learning, biological discovery, causal inference, decision systems, and technical implementation."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / writing</span>
      <h1>Writing</h1>
      <div class="page-intro">
        <span class="section-kicker">Working notes</span>
        <p>An archive of published pieces on scientific machine learning, biological discovery, decision systems, and the practical work of moving from models to experiments or operations.</p>
      </div>
    </div>
  </header>
  <section class="section">
    <div class="shell">
      <WritingArchive posts={posts} />
    </div>
  </section>
</Base>

