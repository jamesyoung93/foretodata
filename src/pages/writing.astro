---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WritingArchive from '../components/WritingArchive.astro';
import { sitePath } from '../utils/paths';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.hidden)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Writing | James Young"
  description="Selected technical essays by James Young on bioinformatics, forecasting, reproducible data workflows, model evaluation, and decision systems."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / writing</span>
      <h1>Writing</h1>
      <div class="page-intro">
        <span class="section-kicker">Selected archive</span>
        <p>A curated set of technical essays published from 2020 through 2025. Each piece is presented in the context of its publication date. Recurring themes include reproducible analysis, interpretable models, and analytical work tied to decisions.</p>
      </div>
      <div class="text-links">
        <a class="text-link" href={sitePath('publications')}>Recent open-access research <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </header>
  <section class="section">
    <div class="shell">
      <WritingArchive posts={posts} />
    </div>
  </section>
</Base>

