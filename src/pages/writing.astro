---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WritingArchive from '../components/WritingArchive.astro';
import { sitePath } from '../utils/paths';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.hidden)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Writing | James Young"
  description="Technical essays by James Young on bioinformatics, forecasting, model evaluation, and decision systems."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / writing</span>
      <h1>Writing</h1>
      <div class="page-intro">
        <span class="section-kicker">Technical essays</span>
        <p>Applied analyses in bioinformatics, forecasting, model evaluation, and analytical decision systems.</p>
      </div>
      <div class="text-links">
        <a class="text-link" href={sitePath('publications')}>Recent open-access research <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </header>
  <section class="section">
    <div class="shell">
      <WritingArchive posts={posts} />
    </div>
  </section>
</Base>

