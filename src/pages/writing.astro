---
import Base from '../layouts/Base.astro';
import { featuredInsights, profile } from '../data/site';
import { sitePath } from '../utils/paths';
---

<Base
  title="Insights | James Young"
  description="Essays by James Young on turning complex evidence into better decisions, systems, and measurable outcomes."
>
  <header class="page-hero">
    <div class="shell">
      <span class="page-path">ForetoData / insights</span>
      <h1>Ideas for turning complex evidence into better decisions.</h1>
      <div class="page-intro">
        <span class="section-kicker">Represent → Simulate → Decide → Learn</span>
        <p>Essays about representing what shapes an outcome, simulating possible actions, building reliable interactive AI, and learning from measurable results.</p>
      </div>
    </div>
  </header>
  <section class="section" aria-label="Featured essays">
    <div class="shell">
      <div class="insight-grid">
        {featuredInsights.map((insight) => (
          <a class="insight-card" href={insight.href} target="_blank" rel="noopener noreferrer">
            <div class="insight-card-meta">
              <span>{insight.published}</span>
              <span aria-hidden="true">↗</span>
            </div>
            <h2>{insight.title}</h2>
            <p>{insight.description}</p>
            <span class="card-action">Read on Substack <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>

      <div class="insight-actions">
        <a class="text-link" href={profile.substackArchive} target="_blank" rel="noopener noreferrer">
          Read all essays and subscribe on Substack <span aria-hidden="true">↗</span>
        </a>
        <a class="archive-link" href={sitePath('writing/archive')}>
          Earlier applied analyses, 2022–2025 <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>

