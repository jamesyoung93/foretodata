---
import '../styles/global.css';
import SoundToggle from '../components/SoundToggle.jsx';
import { profile } from '../data/site';
import { sitePath } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  mode?: 'editorial' | 'lab';
  noindex?: boolean;
}

const {
  title = `${profile.name} | Scientific Machine Learning & Biological Discovery`,
  description = `${profile.summary} Work spanning computational biology, scientific machine learning, and operational decision systems.`,
  canonicalPath,
  mode = 'editorial',
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath ? sitePath(canonicalPath) : currentPath, Astro.site);
const socialImage = new URL(sitePath('og.png'), Astro.site);
const navItems = [
  { label: 'Work', href: sitePath('work'), match: '/work' },
  { label: 'Research', href: sitePath('research'), match: '/research' },
  { label: 'Publications', href: sitePath('publications'), match: '/publications' },
  { label: 'Writing', href: sitePath('writing'), match: '/writing' },
  { label: 'About', href: sitePath('about'), match: '/about' },
];
---

<!doctype html>
<html lang="en" data-mode={mode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ForetoData" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="James Young, scientific machine learning, biological discovery, and decision systems" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body class:list={{ 'lab-body': mode === 'lab' }}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="identity" href={sitePath()} aria-label="James Young, home">
          <span class="platform-mark">ForetoData / field notes</span>
          <span class="identity-name">James Young</span>
          <span class="identity-descriptor">{profile.descriptor}</span>
        </a>

        <nav class="primary-nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath.includes(item.match) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="mode-tools">
          {mode === 'lab' ? (
            <>
              <a class="mode-link" href={sitePath()}><span aria-hidden="true">←</span> Editorial</a>
              <SoundToggle client:load compact={true} />
            </>
          ) : (
            <a class="mode-link" href={sitePath('lab')}><span aria-hidden="true">⌁</span> Lab Mode</a>
          )}
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <strong>{profile.name}</strong>
          <p>ForetoData collects scientific, analytical, and technical work.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar <span aria-hidden="true">↗</span></a>
          <a href={sitePath('lab')}>Lab Mode</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

