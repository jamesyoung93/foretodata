---
import type { CollectionEntry } from 'astro:content';
import { sitePath } from '../utils/paths';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<section class="program-section">
  <div class="program-heading">
    <h2>Technical essays</h2>
    <p>Sequence analysis, hierarchical forecasting, and observational classification.</p>
  </div>
  <div class="archive-list">
    {posts.map((post) => (
      <a class="archive-item" href={sitePath(`posts/${post.slug}`)}>
        <span class="archive-meta">{formatDate(post.data.date)}</span>
        <div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </div>
        <span class="archive-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>
